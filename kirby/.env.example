# Debug mode (never enable in production)
KIRBY_DEBUG=false

# Random salt for content tokens (preview links, media hashes).
# Generate with: openssl rand -hex 32
KIRBY_CONTENT_SALT=

# Random key for session cookies. Generate with: openssl rand -hex 32
KIRBY_COOKIE_KEY=

# Enable multi-language content (languages in site/languages/)
KIRBY_MULTILANG=true

# Allow the Panel installer (enable once for setup, then disable)
KIRBY_PANEL_INSTALL=true

# Panel URL slug (https://cms.example.com/<slug>)
KIRBY_PANEL_SLUG=panel

# Enable the pages cache (recommended in production)
KIRBY_CACHE=false

# Bearer token the Nuxt frontend sends to the KQL API.
# Must match KIRBY_API_TOKEN in the frontend's .env.
# Generate with: openssl rand -hex 32
KIRBY_HEADLESS_API_TOKEN=

# Base URL of the deployed Nuxt frontend (used for Panel preview links)
KIRBY_HEADLESS_FRONTEND_URL=http://localhost:3000
